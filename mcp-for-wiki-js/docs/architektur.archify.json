  "cards": [
    {
      "dot": "cyan",
      "title": "Ein Login für Mensch und KI",
      "items": [
        "KI-Clients autorisieren sich per OAuth 2.1 mit dem normalen Wiki.js-Konto",
        "Tool-Aufrufe laufen mit dem Wiki-JWT des Nutzers — Wiki.js setzt die Rechte durch",
        "Gleiche Domain für Wiki und MCP: eine Wiki-Sitzung macht die Freigabe zum Ein-Klick"
      ]
    },
    {
      "dot": "rose",
      "title": "Schutzschichten",
      "items": [
        "Policy-Gate: allow / confirm / block je Kategorie, Tag-Sperre kein-ki",
        "Freigabe und /me mit CSRF-Nonce, Login-Limits pro IP und Konto",
        "Caddy sperrt /finalize; Ersteinrichtung nur über den Dienst bootstrap",
        "Postgres nur im internen Netz db erreichbar"
      ]
    },
    {
      "dot": "amber",
      "title": "Kubernetes-Variante (Helm)",
      "items": [
        "Chart deployt nur den MCP-Server als StatefulSet mit PVC für /data",
        "Wiki.js läuft separat; Ingress legt nur die MCP-Pfade auf die Wiki-Domain",
        "Eine Replika: sqlite-Store und Login-Limits liegen im Prozess"
      ]
    }
  ]
