    "test:route": "tsx scripts/test-route.ts",
    "test:limits": "tsx scripts/test-limits.ts",
    "test:escalation": "tsx scripts/test-escalation.ts",
    "test:gate": "tsx scripts/test-gate.ts",
    "test:client": "tsx scripts/test-client.ts",
    "test:stdio": "tsx scripts/test-stdio.ts",
    "test:bootstrap": "tsx scripts/test-bootstrap.ts",
    "test:deploy": "tsx scripts/test-deploy.ts",
    "test:live": "tsx scripts/test-local-live.ts",
