# Build context = repo root; only mcp-for-wiki-js/ is copied into the image.
# Everything irrelevant or heavy is excluded so builds stay fast and clean.
wiki/
mcp2/
deploy/
# Exceptions: these ship in the image (self-contained compose variants run them from there).
!deploy/scripts/bootstrap.mjs
!deploy/scripts/standalone-init.mjs
!deploy/caddy/Caddyfile
.github/
.git/
**/.git
**/node_modules
**/.next
**/data
**/*.log
**/.env
**/.env.*
!**/.env.example
