# Build context = repo root; only mcp-for-wiki-js/ is copied into the image.
# Everything irrelevant or heavy is excluded so builds stay fast and clean.
wiki/
mcp2/
deploy/
# Exception: the bootstrap script ships in the image (self-contained compose variants run it from there).
!deploy/scripts/bootstrap.mjs
.github/
.git/
**/.git
**/node_modules
**/.next
**/data
**/*.log
**/.env
**/.env.*
!**/.env.example
