# Eine Domain für Wiki.js UND den MCP-Server.
#
# Gleiche Domain ist Absicht: die Wiki.js-Session (jwt-Cookie) gilt dadurch auch
# auf der OAuth-Freigabeseite des MCP-Servers → Ein-Klick-Autorisierung.
#
# Bei echter Domain besorgt Caddy TLS automatisch (Let's Encrypt, Ports 80+443
# müssen erreichbar sein). Mit DOMAIN=localhost stellt Caddy ein lokales
# Zertifikat aus (Browser-Warnung beim ersten Mal ist normal).
#
# Diese Pfade gehören dem MCP-Server — im Wiki KEINE Seiten unter
# me/, oauth/, mcp, api/ anlegen (siehe mcp-for-wiki-js/docs/oauth.md).

{$DOMAIN:localhost} {
	# HSTS for the whole site, but only over HTTPS (never on the plain-HTTP ":80"
	# test site) and not for "localhost" — HSTS there would pin every local
	# http://localhost app in the browser to HTTPS.
	@hsts {
		protocol https
		not host localhost
	}
	header @hsts ?Strict-Transport-Security "max-age=31536000"

	# Wiki.js setup wizard: POST /finalize creates the first admin account, and
	# Wiki.js serves it to anyone until setup is done (it is the only setup POST
	# route, wiki/server/setup.js). Never reachable from outside — the first-run
	# setup runs inside the Docker network instead:
	#   docker compose run --rm bootstrap
	# Caddy path matching is case-insensitive, so /FINALIZE (Express matches it
	# too) is covered; /finalize/* covers the trailing-slash variant.
	@wikiSetup path /finalize /finalize/*
	handle @wikiSetup {
		respond "Setup only via the bootstrap service" 403
	}

	# Repeated `path` lines in one matcher block are merged (any match wins).
	@mcp {
		path /mcp /mcp/* /oauth/* /me /me/* /api/health
		path /.well-known/oauth-authorization-server* /.well-known/oauth-protected-resource*
		path /.well-known/mcp.json /_next/*
	}

	handle @mcp {
		# Anonymous bodies are read before any auth check — cap them at the edge
		# (the server caps /mcp at 4 MB and forms at 64 KB itself). Wiki paths
		# stay unlimited here: asset uploads go through them.
		request_body {
			max_size 8MB
		}
		reverse_proxy mcp:3000
	}

	handle {
		# Defensive defaults for Wiki.js responses. `?` sets a header only where
		# Wiki.js sends none, so its own (stricter) values always win. SAMEORIGIN,
		# not DENY: Wiki.js editors use same-origin iframes. One directive per
		# header on purpose: in a `header { }` block the `?` conditions are ANDed,
		# so one header from Wiki.js would suppress all the others.
		header ?X-Content-Type-Options nosniff
		header ?Referrer-Policy strict-origin-when-cross-origin
		header ?X-Frame-Options SAMEORIGIN
		reverse_proxy wiki:3000
	}
}
