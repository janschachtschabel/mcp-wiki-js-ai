# Eine Domain für Wiki.js UND den MCP-Server.
#
# Gleiche Domain ist Absicht: die Wiki.js-Session (jwt-Cookie) gilt dadurch auch
# auf der OAuth-Freigabeseite des MCP-Servers → Ein-Klick-Autorisierung.
#
# Bei echter Domain besorgt Caddy TLS automatisch (Let's Encrypt, Ports 80+443
# müssen erreichbar sein). Mit DOMAIN=localhost stellt Caddy ein lokales
# Zertifikat aus (Browser-Warnung beim ersten Mal ist normal).
#
# Diese Pfade gehören dem MCP-Server — im Wiki KEINE Seiten unter
# me/, oauth/, mcp, api/ anlegen (siehe mcp-for-wiki-js/docs/oauth.md).

{$DOMAIN:localhost} {
	# Repeated `path` lines in one matcher block are merged (any match wins).
	@mcp {
		path /mcp /mcp/* /oauth/* /me /me/* /api/health
		path /.well-known/oauth-authorization-server* /.well-known/oauth-protected-resource*
		path /.well-known/mcp.json /_next/*
	}

	handle @mcp {
		# Anonymous bodies are read before any auth check — cap them at the edge
		# (the server caps /mcp at 4 MB and forms at 64 KB itself). Wiki paths
		# stay unlimited here: asset uploads go through them.
		request_body {
			max_size 8MB
		}
		reverse_proxy mcp:3000
	}

	handle {
		reverse_proxy wiki:3000
	}
}
