# =============================================================================
# Wiki.js + MCP — Umgebungsvariablen
# =============================================================================
# Docker-Panels kopieren diese Datei beim Import als .env und bieten sie danach
# zum Bearbeiten an. Mit Repo-Checkout: cp .env.example .env

# --- docker-compose.yml (Hauptordner, hinter vorhandenem Traefik) ------------
# Erst mit leeren Werten bereitstellen, dann ausfüllen und neu bereitstellen.
# Postgres-Passwort und MCP_SESSION_SECRET erzeugt der Stack selbst.
#
# Domain von Wiki + MCP (nur der Hostname, DNS zeigt auf den Server).
DOMAIN=
# Erstes Admin-Konto — wird automatisch angelegt, sobald DOMAIN gesetzt ist.
# ADMIN_PASSWORD nach der Einrichtung wieder leeren.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Zusätzliche Parameter der Ersteinrichtung (Deutsch ist voreingestellt):
#   --locale=en   andere Sprache
#   --demo        Gruppe „Team“ + Testnutzer (braucht DEMO_PASSWORD; nur Test-Instanzen)
# BOOTSTRAP_ARGS=
# Traefik-Anbindung (Defaults passen zum üblichen Panel-Traefik: Eingang websecure,
# Zertifikatsdienst letsencrypt).
# TRAEFIK_NETWORK: Netz des Stacks, wird angelegt; nur ändern, wenn Traefik in
# einem eigenen Docker-Netz läuft (dann dessen Namen, z. B. traefik-proxy).
# TRAEFIK_NETWORK=wikijs-web
# TRAEFIK_ENTRYPOINT=websecure
# TRAEFIK_CERTRESOLVER=letsencrypt

# --- docker-compose.build.yml (Image selbst bauen, eigener Caddy) ------------
# COMPOSE_FILE=docker-compose.build.yml   # dann gilt `docker compose …` ohne -f
# Dort Pflicht: DOMAIN (oben) sowie
# POSTGRES_PASSWORD=                      # openssl rand -base64 24
# MCP_SESSION_SECRET=                     # mind. 16 Zeichen: openssl rand -base64 32
# Optional: abweichende öffentliche Basis-URL (Default: https://$DOMAIN).
# PUBLIC_BASE_URL=
# Wiki.js-DB-Pool (via deploy/wiki/config.yml); 20 Verbindungen sind für
# Postgres (max_connections=100) unkritisch.
# WIKIJS_DB_POOL_MIN=2
# WIKIJS_DB_POOL_MAX=20
# Fertiges Image statt lokalem Build:
# MCP_IMAGE=ghcr.io/janschachtschabel/mcp-wiki-js-ai:main

# --- Für alle Varianten optional ---------------------------------------------
# Seiten mit diesen Tags sind für KI-Agenten unsichtbar & unantastbar
# (kommasepariert, case-insensitive; leer = Feature aus). Ausnahme: Kommentare,
# die nur per Kommentar-ID angesprochen werden (get/update/delete).
# WIKIJS_BLOCKED_TAGS=kein-ki
# Parallele Upstream-Requests des MCP-Servers (unter dem Wiki.js-DB-Pool halten;
# Default 6, mit docker-compose.build.yml 12).
# WIKIJS_MAX_CONCURRENCY=6
# Agenten-Schutzrolle für OAuth-Sessions (config/roles.json im MCP-Server).
# WIKIJS_OAUTH_ROLE=wiki
# Globales Rechte-Ceiling des MCP-Servers (bei OAuth: full lassen).
# WIKIJS_PERMISSION_PRESET=full
# Audit-Log (Tool, Nutzer-Label, Ergebnis) — an/aus.
# WIKIJS_AUDIT=true
# OAuth-Redirects nur an diese Hosts erlauben (kommagetrennt; Loopback bleibt
# erlaubt; leer = jeder https-Host).
# MCP_ALLOWED_REDIRECT_HOSTS=claude.ai,chatgpt.com
# Backup-Sidecar: Intervall in Sekunden (Default 1 Tag) und Anzahl aufbewahrter Stände.
# BACKUP_INTERVAL_SECONDS=86400
# BACKUP_KEEP=7
# Zeitzone der Zeitangaben auf /me.
# TZ=Europe/Berlin
